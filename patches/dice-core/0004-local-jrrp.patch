+//当日值记在用户数据里（jrrp_date/jrrp_val），当日记录没来得及保存就重启时，也不会变成另一个数
+//连续低值次数记在 jrrp_low_streak，达到 JrrpPityDays 后下一次悄悄往上取值，规则见 DiceJrrp.h
+static std::mutex mtJrrp;
 AttrVar DiceToday::getJrrp(long long uid) {
+	std::lock_guard<std::mutex> lock(mtJrrp);
 	if (UserInfo.count(uid) && UserInfo[uid]->has("jrrp"))
 		return UserInfo[uid]->get("jrrp");
-	string frmdata = "QQ=" + to_string(console.DiceMaid) + "&v=20190114" + "&QueryQQ=" + to_string(uid);
-	string res;
-	if (Network::POST("http://api.kokona.tech:5555/jrrp", frmdata, "", res)) {
-		return UserInfo[uid]->at("jrrp") = stoi(res);
+	const int date{ (stToday.tm_year + 1900) * 10000 + (stToday.tm_mon + 1) * 100 + stToday.tm_mday };
+	User& user{ getUser(uid) };
+	int val{ 0 };
+	if (user.getConf("jrrp_date") == date && user.has("jrrp_val")) {
+		val = user.getConf("jrrp_val");
 	}
 	else {
-		if (!UserInfo[uid]->has("jrrp_local")) {
-			UserInfo[uid]->at("jrrp_local") = RandomGenerator::Randint(1, 100);
-			console.log(fmt->format("JRRP获取失败! 错误信息: \n{res}",
-				AttrVars{ {"res", res} }
-			), 0);
-		}
-		return UserInfo[uid]->get("jrrp_local");
+		const jrrp::Params params{ console["JrrpMin"], console["JrrpMax"], console["JrrpLowLine"],
+			console["JrrpPityDays"], console["JrrpPityMin"] };
+		const jrrp::Result res{ jrrp::roll(params, user.getConf("jrrp_low_streak"),
+			[](int lo, int hi) { return RandomGenerator::Randint(lo, hi); }) };
+		val = res.value;
+		user.setConf("jrrp_date", date);
+		user.setConf("jrrp_val", val);
+		user.setConf("jrrp_low_streak", res.next_streak);
 	}
+	get(uid)->at("jrrp") = val;
+	save();
+	return val;
 }
 
