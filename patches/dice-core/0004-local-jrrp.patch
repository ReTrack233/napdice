diff --git a/Dice/DiceJrrp.h b/Dice/DiceJrrp.h
new file mode 100644
index 0000000..1795a75
--- /dev/null
+++ b/Dice/DiceJrrp.h
@@ -0,0 +1,50 @@
+#pragma once
+/*
+ * 今日人品（本地生成）
+ *
+ * 只含纯逻辑，不依赖核心的其他部分：随机数由调用方传入，方便单独测试。
+ * 参数对应 console 的设置项，见 DiceConsole.cpp：
+ *   JrrpMin、JrrpMax  人品值在 [JrrpMin, JrrpMax] 内均匀取值；填反了自动对调
+ *   JrrpLowLine       人品值不高于此值算一次低值；0 表示不统计（低值补偿随之失效）
+ *   JrrpPityDays      连续低值达到此次数后，下一次在 [JrrpPityMin, JrrpMax] 内取值；0 表示关闭
+ *   JrrpPityMin       低值补偿时的下限，会被限制在 [JrrpMin, JrrpMax] 之内
+ * 低值补偿不会在回复中体现。“连续”按查询过人品的日子计算：中间没有查询的日子既不计入，也不打断。
+ */
+// min/max 加括号调用：核心在 Windows 下引入 <Windows.h> 时没有定义 NOMINMAX
+#include <algorithm>
+
+namespace jrrp {
+
+struct Params {
+	int min = 1;
+	int max = 100;
+	int low_line = 20;
+	int pity_days = 2;
+	int pity_min = 50;
+};
+
+struct Result {
+	int value = 0;       // 今日人品
+	bool pity = false;   // 本次是否做了低值补偿
+	int streak = 0;      // 本次之前已连续低值的次数
+	int next_streak = 0; // 计入本次之后的连续低值次数，写回用户数据
+};
+
+// randint(lo, hi) 须返回闭区间 [lo, hi] 内均匀分布的整数
+template <class RandInt>
+Result roll(const Params& p, int prev_streak, RandInt&& randint) {
+	const int lo{ (std::min)(p.min, p.max) }, hi{ (std::max)(p.min, p.max) };
+	Result r;
+	r.streak = (std::max)(prev_streak, 0);
+	if (p.pity_days > 0 && p.low_line > 0 && r.streak >= p.pity_days) {
+		r.pity = true;
+		r.value = randint(std::clamp(p.pity_min, lo, hi), hi);
+	}
+	else {
+		r.value = randint(lo, hi);
+	}
+	r.next_streak = (p.low_line > 0 && r.value <= p.low_line) ? r.streak + 1 : 0;
+	return r;
+}
+
+}
